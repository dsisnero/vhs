require "file_utils"
require "process"

require "./styles"

module Vhs
  # ghostHost and ghostPort are the upload endpoint behind vhs.charm.sh.
  GHOST_HOST = "ghost.charm.sh"
  GHOST_PORT = 22

  # PublishError carries a failed upload's message.
  class PublishError < Exception
  end

  # publish uploads the given GIF file and returns the URL the server answers
  # with, ported from upstream publish.go.
  #
  # Upstream dials ghost.charm.sh with golang.org/x/crypto/ssh, using an Ed25519
  # key generated by charmbracelet/keygen and a known_hosts file it appends to on
  # first contact. The port hands the transport to OpenSSH instead
  # (`ssh`/`ssh-keygen`): the same key file, the same known_hosts file, the same
  # "trust a new host, refuse a changed key" policy, and the GIF on stdin, which
  # is exactly what upstream's session does with `io.Copy(in, f)`.
  def self.publish(path : String, *, data_path : String? = nil) : String
    dir = data_path || self.data_path
    FileUtils.mkdir_p(dir)

    key = publish_key(dir)
    known_hosts = publish_known_hosts(dir)

    result = IO::Memory.new
    errors = IO::Memory.new

    File.open(path) do |file|
      status = Process.run(
        "ssh",
        ssh_arguments(key, known_hosts),
        input: file,
        output: result,
        error: errors,
      )

      unless status.success?
        message = errors.to_s.strip
        message = "ssh exited with #{status.exit_code}" if message.empty?
        raise PublishError.new(message)
      end
    end

    result.to_s
  end

  # ssh_arguments builds the OpenSSH invocation that mirrors upstream's
  # ssh.ClientConfig.
  #
  # `-F /dev/null` because x/crypto/ssh never reads the user's ssh_config, `-T`
  # because it never allocates a pty, and `accept-new` because upstream's
  # hostKeyCallback appends an unseen host to known_hosts but rejects a changed
  # key.
  def self.ssh_arguments(key : String, known_hosts : String) : Array(String)
    [
      "-F", File::NULL,
      "-T",
      "-i", key,
      "-o", "IdentitiesOnly=yes",
      "-o", "BatchMode=yes",
      "-o", "StrictHostKeyChecking=accept-new",
      "-o", "UserKnownHostsFile=#{known_hosts}",
      "-p", GHOST_PORT.to_s,
      "vhs@#{GHOST_HOST}",
    ]
  end

  # publish_key returns the path of the upload key, generating the Ed25519 key on
  # first publish like keygen.New(..., WithKeyType(Ed25519), WithWrite()).
  def self.publish_key(dir : String) : String
    path = File.join(dir, "vhs_ed25519")
    return path if File.exists?(path)

    errors = IO::Memory.new
    status = Process.run(
      "ssh-keygen",
      ["-q", "-t", "ed25519", "-N", "", "-C", "", "-f", path],
      output: errors,
      error: errors,
    )
    unless status.success?
      message = errors.to_s.strip
      raise PublishError.new(message.empty? ? "could not generate #{path}" : message)
    end

    path
  end

  # publish_known_hosts returns the known_hosts path, creating it 0600 like
  # upstream's os.OpenFile(path, O_WRONLY|O_CREATE|O_APPEND, 0600).
  def self.publish_known_hosts(dir : String) : String
    path = File.join(dir, "known_hosts")
    unless File.exists?(path)
      File.write(path, "")
      File.chmod(path, 0o600)
    end

    path
  end

  # data_path mirrors upstream dataPath(), which is go-app-paths' user data scope
  # for "vhs": ~/Library/Application Support/vhs on macOS, $XDG_DATA_HOME/vhs
  # (~/.local/share/vhs by default) on the other Unixes, and
  # %LOCALAPPDATA%\vhs on Windows.
  def self.data_path(env = ENV) : String
    home = home_dir(env)

    {% if flag?(:darwin) %}
      File.join(home, "Library", "Application Support", "vhs")
    {% elsif flag?(:win32) %}
      local = env["LOCALAPPDATA"]?
      base = local && !local.empty? ? local : File.join(home, "AppData", "Local")
      File.join(base, "vhs")
    {% else %}
      xdg = env["XDG_DATA_HOME"]?
      base = xdg && !xdg.empty? ? xdg : File.join(home, ".local", "share")
      File.join(base, "vhs")
    {% end %}
  end

  private def self.home_dir(env) : String
    home = env["HOME"]? || env["USERPROFILE"]?
    raise PublishError.new("could not determine the user home directory") if home.nil? || home.empty?

    home
  end

  # publish_share_instructions prints the shareable-URL snippets. Upstream logs
  # them with log.Println, which writes to stderr.
  def self.publish_share_instructions(url : String, io : IO = STDERR) : Nil
    io.puts
    io.puts Styles::GRAY_STYLE.render("  Share your GIF with Markdown:")
    io.puts Styles::COMMAND_STYLE.render("  ![Made with VHS]") + Styles::URL_STYLE.render("(#{url})")
    io.puts Styles::GRAY_STYLE.render("\n  Or HTML (with badge):")
    io.puts Styles::COMMAND_STYLE.render("  <img ") + Styles::COMMAND_STYLE.render("src=") +
            Styles::URL_STYLE.render("\"#{url}\"") + Styles::COMMAND_STYLE.render(" alt=") +
            Styles::URL_STYLE.render("\"Made with VHS\"") + Styles::COMMAND_STYLE.render(">")
    io.puts Styles::COMMAND_STYLE.render("  <a ") + Styles::COMMAND_STYLE.render("href=") +
            Styles::URL_STYLE.render("\"https://vhs.charm.sh\"") + Styles::COMMAND_STYLE.render(">")
    io.puts Styles::COMMAND_STYLE.render("    <img ") + Styles::COMMAND_STYLE.render("src=") +
            Styles::URL_STYLE.render("\"https://stuff.charm.sh/vhs/badge.svg\"") + Styles::COMMAND_STYLE.render(">")
    io.puts Styles::COMMAND_STYLE.render("  </a>")
    io.puts Styles::GRAY_STYLE.render("\n  Or link to it:")
  end
end
